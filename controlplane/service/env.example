# Copy to a file OUTSIDE the repository (for example ~/agentvow-cp.env), fill in, and never commit it:  set -a; . ~/agentvow-cp.env; set +a
AGENTVOW_CP_APP_ID=123456
# Path to the .pem file GitHub gave you when you generated the App's private key (preferred over putting the key in the environment)
AGENTVOW_CP_PRIVATE_KEY_FILE=/Users/you/agentvow-app.private-key.pem
# The same string you typed into the App's "Webhook secret" field (make one with: openssl rand -hex 32)
AGENTVOW_CP_WEBHOOK_SECRET=replace-with-64-hex-characters
# Audience prefix. The gate asks GitHub for a token for "<this>:<sha256 of the receipt>"; the workflow input `audience` must equal it
AGENTVOW_CP_AUDIENCE=agentvow-control-plane
# Exact job_workflow_ref values to trust, comma separated, each pinned to a FULL 40-character commit sha (the service refuses a tag or branch):
#   <owner>/<repo>/.github/workflows/gate-service.yml@<40 hex>
AGENTVOW_CP_TRUSTED_WORKFLOWS=your-user/agentvow-live-test/.github/workflows/gate-service.yml@0000000000000000000000000000000000000000
AGENTVOW_CP_DB=/Users/you/agentvow-cp.db

# EXPERIMENTAL, leave unset unless you have read docs/FORK_PRS.md: the fork gate workflow(s), each pinned to a full 40-character sha
# AGENTVOW_CP_FORK_WORKFLOWS=your-user/agentvow-live-test/.github/workflows/gate-service-fork.yml@0000000000000000000000000000000000000000
